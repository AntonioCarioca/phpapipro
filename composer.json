{
    "name": "antonio/php-rest-api-pro",
    "description": "API REST profissional em PHP com PDO, JSON responses e CRUD de usuários.",
    "type": "project",
    "license": "MIT",
    "require":
    {
        "php": "^8.1",
        "firebase/php-jwt": "^7.0"
    },
    "autoload":
    {
        "psr-4":
        {
            "App\\": "app/"
        }
    },
    "scripts":
    {
        "migrate": "php scripts/migrate.php",
        "seed": "php scripts/seed.php",
        "test": "phpunit",
        "analyse": "phpstan analyse app tests scripts public/index.php",
        "cs": "phpcs app tests scripts public/index.php",
        "cs:fix": "phpcbf app tests scripts public/index.php"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^4.0"
    }
}
